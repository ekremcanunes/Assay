# docker compose bu dosyayi proje kokunde ".env" adiyla otomatik okur.
# cp .env.example .env  ->  degerleri doldur  ->  docker compose up -d --build

# --- Kratos kimlik veritabani ---
# Secenek A: compose icindeki yerel postgres container'i (dis servis gerekmez)
KRATOS_DSN=postgres://kratos:kratospassword@postgres:5432/kratos?sslmode=disable
# Secenek B: Neon
# KRATOS_DSN=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Portfolio verisi (.NET / Npgsql formati, DSN degil) ---
# Secenek A: yerel postgres (Kratos ile ayni instance, tablolar yan yana durur)
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=kratos;Username=kratos;Password=kratospassword
# Secenek B: Neon
# DB_CONNECTION_STRING=Host=YOUR_NEON_HOST;Database=neondb;Username=USER;Password=PASS;SSL Mode=Require;Trust Server Certificate=true

# --- Twelve Data (sadece sembol aramasi icin) ---
TWELVEDATA_API_KEY=

# --- Loglama (bkz. docs/10-standards/LOGGING.md) ---
# Bos birakilirsa Information kullanilir. Prod (AWS) icin: Warning
# UYARI: gecersiz bir deger (orn. "info") servisi baslangicta cokertir.
LOG_LEVEL=Information

# Framework loglari (Microsoft, System). Varsayilan Warning; sadece tesbit icin gecici acilir.
# Information'a cikarilinca ASP.NET'in "Request starting" satiri query string'i de loglar
# (bkz. LOGGING.md 4 - hassas veri). Is bitince Warning'e geri alinir.
LOG_LEVEL_FRAMEWORK=Warning

# EF Core loglari (sadece portfolio-service). Information her SQL sorgusunu loglar,
# hacmin baslica kaynagidir. Ayri kadran: framework'u acmadan SQL'i acabilirsin.
LOG_LEVEL_EFCORE=Warning
