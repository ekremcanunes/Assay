# docker compose bu dosyayi proje kokunde ".env" adiyla otomatik okur.
# cp .env.example .env  ->  degerleri doldur  ->  docker compose up -d --build

# --- Kratos kimlik veritabani (Neon - bulut Postgres) ---
KRATOS_DSN=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Kratos sirlari (kratos.yml'deki ornek degerleri ezer) ---
# Uret: openssl rand -hex 16   (32 karakter; cipher TAM 32 olmali)
# Her ortamda (dev/prod) farkli deger kullan.
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=

# --- Portfolio verisi (.NET / Npgsql formati, DSN degil) ---
DB_CONNECTION_STRING=Host=YOUR_NEON_HOST;Database=neondb;Username=USER;Password=PASS;SSL Mode=Require;Trust Server Certificate=true

# --- Twelve Data (sadece sembol aramasi icin) ---
TWELVEDATA_API_KEY=

# --- Loglama (bkz. docs/10-standards/LOGGING.md) ---
# Bos birakilirsa Information kullanilir. Prod (AWS) icin: Warning
# UYARI: gecersiz bir deger (orn. "info") servisi baslangicta cokertir.
LOG_LEVEL=Information

# Framework loglari (Microsoft, System). Varsayilan Warning; sadece tesbit icin gecici acilir.
# Information'a cikarilinca ASP.NET'in "Request starting" satiri query string'i de loglar
# (bkz. LOGGING.md 4 - hassas veri). Is bitince Warning'e geri alinir.
LOG_LEVEL_FRAMEWORK=Warning

# EF Core loglari (sadece portfolio-service). Information her SQL sorgusunu loglar,
# hacmin baslica kaynagidir. Ayri kadran: framework'u acmadan SQL'i acabilirsin.
LOG_LEVEL_EFCORE=Warning

# --- SMS relay (bkz. docs/20-modules/SMS-RELAY.md) ---
# Kratos ile portfolio-service arasindaki paylasilan anahtar. Uret: openssl rand -hex 32
SMS_RELAY_API_KEY=
# false = SMS kanali kapali: relay reddeder, giriste SMS secenegi gosterilmez.
# Simdilik KAPALI: telefon yalnizca profil bilgisi (identity.schema.json'da dogrulama isareti yok).
# Acmadan once sema isaretleri geri eklenmeli; bkz. docs/20-modules/SMS-RELAY.md.
SMS_ENABLED=false
# Gunluk SMS tavani. 0 = tavan hemen dolar, SMS gitmez.
SMS_DAILY_LIMIT=16

# Saglayici (generic REST). Saglayici degistirmek = bu degerleri onun API dokumanina gore doldurmak.
# Dev: Mailpit'in HTTP API'si; SMS'ler http://localhost:8025'te e-posta olarak gorunur.
# Bos SMS_URL = SMS kanali kapali (servis yine acilir, logda hata satiri).
SMS_URL=http://mailpit:8025/api/v1/send
# SMS basligi; sablonda {sender}.
SMS_SENDER=
# Kimlik dogrulama header'i. Bos = header eklenmez. Ornek: Authorization / X-Api-Key
SMS_AUTH_HEADER=
# Header degeri (SIR). Ornek: "Bearer <token>" ya da "Basic <base64(kullanici:sifre)>"
SMS_AUTH_VALUE=
# JSON govde sablonu. Yer tutucular: {to} (+905...), {message}, {sender}. Tek tirnak icinde yazilir.
SMS_BODY_TEMPLATE='{"From":{"Email":"sms@assay.local"},"To":[{"Email":"sms@assay.local"}],"Subject":"SMS {to}","Text":"{message}"}'

# --- 2FA / dogrulama acma-kapama (spec §10.1). Degistir -> docker compose up -d (restart YETMEZ) ---
AUTH_REQUIRED_AAL=highest_available  # aal1 = OTP adimi kapali
AUTH_VERIFICATION_ENABLED=true    # false = kayitta dogrulama yok
EMAIL_OTP_ENABLED=true            # false = giriste e-posta secenegi gosterilmez (yalnizca arayuz; bkz. SMS-RELAY.md)
# 2FA zorunluyken SMS ve e-posta ikisi de kapaliysa /api/auth/options 500 auth_misconfigured doner.

# --- Kratos e-posta (dev: bos birak -> Mailpit; prod: Resend SMTP) ---
COURIER_SMTP_CONNECTION_URI=
COURIER_SMTP_FROM_ADDRESS=
